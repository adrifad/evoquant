# OKX Demo Trading credentials — spec §5.1
# Create at: OKX → Trade → Demo Trading → Personal Center → Demo Trading API
OKX_API_KEY=
OKX_API_SECRET=
***

# EvoQuant refuses to start unless OKX_ENV=demo (spec §44 hard guard)
OKX_ENV=demo

# Enable historical trade memory in Swing and Scalp LLM gates.
# Disabling this does not disable the LLM veto gate. Default: off.
# Repository .env edits apply on the next gate call; process-managed env changes require a process restart.
GATE_MEMORY_ENABLED=false

# LLM provider (OpenAI-compatible; e.g. kiosapi)
LLM_BASE_URL=https://kiosapi.com/v1/
LLM_API_KEY=
LLM_MO…free
